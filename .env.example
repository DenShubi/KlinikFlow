# KlinikFlow environment variables
# Copy to .env.local and fill in. Never commit .env.local or any real key.
# NEXT_PUBLIC_* values are sent to the browser; everything else stays on the server.

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API Keys (or `npx supabase status` for the local stack)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. Bypasses row-level security: use only in trusted server code (seed, webhooks).
SUPABASE_SECRET_KEY=sb_secret_xxx

# Password for the demo staff accounts created by `npm run staff:seed` (min 10 characters)
DEMO_STAFF_PASSWORD=

# ── App ─────────────────────────────────────────────────────────────────────
# Public base URL, used in WhatsApp links and auth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
# true = treat every doctor as open regardless of working hours (demos at night or on weekends)
CLINIC_ALWAYS_OPEN=false

# ── AI estimator ────────────────────────────────────────────────────────────
# Server only. The Gemini key never reaches the browser or the repo.
GEMINI_API_KEY=
# Gemini model id (empty = the default in src/lib/ai/estimate-core.ts)
GEMINI_MODEL=
# How long to wait for Gemini before using the fallback (ms; default 4000, 6000-8000 on slow networks)
GEMINI_TIMEOUT_MS=
# Wait shown when the AI estimate fails or is not plugged in yet (minutes)
QUEUE_FALLBACK_CONSULT_MINUTES=10

# ── WhatsApp notifications ──────────────────────────────────────────────────
# Provider not decided yet; names below assume the WhatsApp Cloud API.
# false = log messages instead of sending (stub until credentials are approved)
WHATSAPP_SEND_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Shared secret you choose; the provider echoes it when verifying the webhook URL
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
